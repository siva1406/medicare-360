{
  "name": "medicare-360",
  "version": "1.0.0",
  "description": "MediCare 360 - Smart Healthcare Management System",
  "type": "module",
  "scripts": {
    "postinstall": "npm run install:all",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "start": "node run-all.js",
    "build": "cd client && npm run build",
    "build:all": "cd client && npm run build && cd ../frontend && npm run build",
    "seed": "cd server && npm run seed",
    "test": "cd server && npm test",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["healthcare", "react", "express", "mongodb", "mongoose", "hospital-management"],
  "author": "MediCare 360 Team",
  "license": "MIT"
}
